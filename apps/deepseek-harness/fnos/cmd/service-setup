#!/bin/bash

LOG_FILE="${TRIM_PKGVAR}/deepseek-harness.log"
PID_FILE="${TRIM_PKGVAR}/deepseek-harness.pid"

APP_DIR="${TRIM_APPDEST}"
APP_DATA_DIR="${TRIM_PKGVAR}"

export PATH="${APP_DIR}/bin:$PATH"
export HOME="${TRIM_PKGVAR}"

# 使用单一 Node 进程统一调度器 runner.js
SERVICE_COMMAND="${APP_DIR}/bin/node ${APP_DIR}/bin/runner.js"

# 服务端口定义（与 manifest 的 service_port、runner.js 保持一致）
SERVICE_PORT=3080
INTERNAL_PORT=3081
PORT_PATTERN=":(${SERVICE_PORT}|${INTERNAL_PORT}) "
SVC_BACKGROUND=y
SVC_WRITE_PID=y
SVC_CWD="${TRIM_PKGVAR}"
SVC_WAIT_TIMEOUT=15

# ---- 进程清理共享函数：prestart / preuninst / poststop 复用 ----

# 杀掉 PID 文件记录的进程并移除 PID 文件
kill_recorded_pid() {
    if [ -f "${PID_FILE}" ]; then
        local old_pid=$(head -n 1 "${PID_FILE}" 2>/dev/null | tr -d '[:space:]')
        if [ -n "${old_pid}" ]; then
            kill -9 "${old_pid}" 2>/dev/null || true
        fi
        rm -f "${PID_FILE}" 2>/dev/null || true
    fi
}

# 按命令行特征清理残留进程；pgrep -f 会匹配自身 shell，必须先收集 PID 再排除自身
kill_pattern() {
    local pattern="$1"
    local pid
    for pid in $(pgrep -f "${pattern}" 2>/dev/null); do
        [ -n "${pid}" ] && [ "${pid}" != "$$" ] && kill -9 "${pid}" 2>/dev/null || true
    done
}

# 按端口清理 3080/3081 持有者（appcenter 直启的 dsh 命令行可能不含 runner.js 特征）
kill_port_owners() {
    local pid
    for pid in $(netstat -tlnp 2>/dev/null | grep -E "${PORT_PATTERN}" | sed -n 's/.*[[:space:]]\([0-9]\+\)\/[A-Za-z0-9_+.-]*[[:space:]]*$/\1/p' | sort -un); do
        [ -z "${pid}" ] && continue
        [ "${pid}" = "$$" ] && continue
        kill -9 "${pid}" 2>/dev/null || true
    done
}

service_prestart() {
    # 1. 启动前强制清理可能占用端口的残留进程，防止 EADDRINUSE 报错
    kill_recorded_pid
    kill_pattern "${APP_DIR}/bin/runner\.js"

    # 1b. 按端口清理 3080/3081 持有者
    kill_port_owners

    # 2. 如果向导跳过 (用户选以后配置)，确保创建空的向导变量文件，防止状态机空检查异常
    if [ ! -f "${TRIM_PKGVAR}/wizard_variables" ]; then
        touch "${TRIM_PKGVAR}/wizard_variables" 2>/dev/null || true
    fi

    # 3. 确保存储和配置目录存在且具备写权限
    mkdir -p "${TRIM_PKGVAR}/config" 2>/dev/null || true

    # 4. 确保飞牛共享目录打通
    SHARE_WORKSPACE="/vol1/@appshare/DeepSeekHarness"
    if [ -d "/vol1" ]; then
        mkdir -p "${SHARE_WORKSPACE}/workspace" "${SHARE_WORKSPACE}/data" 2>/dev/null || true
        # 权限与 config/privilege（run-as: package）和 config/resource（rw: 专用用户）
        # 声明对齐：owner 读写执行、其他人无权限。绝不能 chmod -R 777——那会把
        # .dsh/.credentials.yaml（API Key）变成全局可读，新版 dsh 也会因权限过宽拒启。
        chown -R deepseek-harness:deepseek-harness "${SHARE_WORKSPACE}" 2>/dev/null || true
        chmod -R u+rwX,go-rwx "${SHARE_WORKSPACE}" 2>/dev/null || true
        # 凭据目录显式收紧（历史版本可能放宽过）
        chmod 700 "${SHARE_WORKSPACE}/.dsh" 2>/dev/null || true
        chmod 600 "${SHARE_WORKSPACE}/.dsh/.credentials.yaml" 2>/dev/null || true
        # data 若已是符号链接则直接刷新；真目录仅在为空时替换为链接，非空则保留并跳过
        if [ -L "${TRIM_PKGVAR}/data" ]; then
            ln -sfn "${SHARE_WORKSPACE}" "${TRIM_PKGVAR}/data" 2>/dev/null || true
        elif [ -d "${TRIM_PKGVAR}/data" ]; then
            if rmdir "${TRIM_PKGVAR}/data" 2>/dev/null; then
                ln -sfn "${SHARE_WORKSPACE}" "${TRIM_PKGVAR}/data" 2>/dev/null || true
            fi
        else
            ln -sfn "${SHARE_WORKSPACE}" "${TRIM_PKGVAR}/data" 2>/dev/null || true
        fi
    fi
}

service_postinst() {
    service_prestart
}

service_postupgrade() {
    service_prestart
}

service_preuninst() {
    kill_recorded_pid
    kill_pattern "${APP_DIR}/bin/runner\.js"
}

service_poststop() {
    service_preuninst
}

