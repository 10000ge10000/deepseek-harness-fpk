#!/bin/bash

APPNAME="deepseek-harness"

# 服务端口定义（与 manifest 的 service_port、runner.js 保持一致）
SERVICE_PORT=3080
INTERNAL_PORT=3081
PORT_PATTERN=":(${SERVICE_PORT}|${INTERNAL_PORT}) "

# 自动推导应用与数据目录
if [ -z "${TRIM_APPDEST:-}" ]; then
    if [ -e "/var/apps/${APPNAME}/target" ]; then
        TRIM_APPDEST=$(readlink -f "/var/apps/${APPNAME}/target" 2>/dev/null || echo "/var/apps/${APPNAME}/target")
    else
        TRIM_APPDEST="/vol1/@appcenter/${APPNAME}"
    fi
fi

if [ -z "${TRIM_PKGVAR:-}" ]; then
    if [ -e "/var/apps/${APPNAME}/var" ]; then
        TRIM_PKGVAR=$(readlink -f "/var/apps/${APPNAME}/var" 2>/dev/null || echo "/var/apps/${APPNAME}/var")
    else
        TRIM_PKGVAR="/vol1/@appdata/${APPNAME}"
    fi
fi

mkdir -p "${TRIM_PKGVAR}" 2>/dev/null || true

LOG_FILE="${TRIM_PKGVAR}/${APPNAME}.log"
PID_FILE="${TRIM_PKGVAR}/${APPNAME}.pid"

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "${LOG_FILE}"
}

# 按命令行特征找回存活实例（PID 文件丢失/失效时的自愈兜底）
# pgrep 需排除自身，避免命中正在执行本脚本的 bash 进程
runner_pids() {
    pgrep -f "${TRIM_APPDEST}/bin/runner.js" 2>/dev/null | grep -vx "$$" | head -n 1
}

dsh_pids() {
    pgrep -f "${TRIM_APPDEST}/node_modules/@deepseek-ai/dsh.*bin.js web" 2>/dev/null | grep -vx "$$" | head -n 1
}

instance_alive() {
    local pid="$1"
    [ -n "${pid}" ] && kill -0 "${pid}" 2>/dev/null
}

# 端口 3080/3081 已被本应用实例占用时，找到对应的 runner 或 dsh 进程
port_owner_pid() {
    local owner
    owner=$(netstat -tlnp 2>/dev/null | grep -E "${PORT_PATTERN}" | sed -n 's/.*[[:space:]]\([0-9]\+\)\/[A-Za-z0-9_+.-]*[[:space:]]*$/\1/p' | sort -un | head -n 1)
    [ -n "${owner}" ] && echo "${owner}"
}

recover_running_instance() {
    local pid
    pid=$(runner_pids)
    if instance_alive "${pid}"; then
        printf "%s" "${pid}" > "${PID_FILE}"
        log_msg "Recovered running instance PID ${pid} (PID file was missing/stale)"
        return 0
    fi
    return 1
}

start_process() {
    log_msg "Starting ${APPNAME}..."

    # 检查是否已在运行：优先读 PID 文件，丢失/失效时按命令行特征兜底找回
    if [ -f "${PID_FILE}" ]; then
        local old_pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        if instance_alive "${old_pid}"; then
            log_msg "${APPNAME} already running with PID ${old_pid}"
            return 0
        fi
        rm -f "${PID_FILE}"
    fi
    if recover_running_instance; then
        return 0
    fi

    # 启动前确认端口未被本应用实例占用（避免双实例 EADDRINUSE 误报失败）
    local bound_pid
    bound_pid=$(port_owner_pid)
    if instance_alive "${bound_pid}"; then
        log_msg "Port 3080/3081 held by PID ${bound_pid}, treating as running"
        printf "%s" "${bound_pid}" > "${PID_FILE}"
        return 0
    fi

    export PATH="${TRIM_APPDEST}/bin:$PATH"
    export HOME="${TRIM_PKGVAR}"
    export TRIM_APPDEST="${TRIM_APPDEST}"
    export TRIM_PKGVAR="${TRIM_PKGVAR}"

    cd "${TRIM_PKGVAR}"

    # 启动统一调度器 runner.js
    "${TRIM_APPDEST}/bin/node" "${TRIM_APPDEST}/bin/runner.js" >> "${LOG_FILE}" 2>&1 &
    local new_pid=$!
    printf "%s" "${new_pid}" > "${PID_FILE}"
    log_msg "Started with PID: ${new_pid}"

    # 验证是否成功启动：循环探测，避免 1 秒后才崩溃被误报为成功
    local count=0
    while [ ${count} -lt 10 ]; do
        if ! kill -0 "${new_pid}" 2>/dev/null; then
            log_msg "Failed to start or process exited early (after ${count}s)"
            rm -f "${PID_FILE}"
            return 1
        fi
        sleep 1
        count=$((count + 1))
    done
    return 0
}

stop_process() {
    log_msg "Stopping ${APPNAME}..."

    if [ -f "${PID_FILE}" ]; then
        local pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        if [ -n "${pid}" ] && kill -0 "${pid}" 2>/dev/null; then
            log_msg "Sending TERM to PID ${pid}"
            kill -TERM "${pid}" 2>/dev/null || true

            local count=0
            while kill -0 "${pid}" 2>/dev/null && [ $count -lt 5 ]; do
                sleep 1
                count=$((count + 1))
            done

            if kill -0 "${pid}" 2>/dev/null; then
                log_msg "Force killing PID ${pid}"
                kill -KILL "${pid}" 2>/dev/null || true
            fi
        fi
    fi

    # 按端口（3080/3081）清理持有者：appcenter 可能直启的 dsh 命令行不含特征串
    local port_pids
    port_pids=$(netstat -tlnp 2>/dev/null | grep -E "${PORT_PATTERN}" | sed -n 's/.*[[:space:]]\([0-9]\+\)\/[A-Za-z0-9_+.-]*[[:space:]]*$/\1/p' | sort -un)
    for pid in $(echo "${port_pids}"); do
        [ -z "${pid}" ] && continue
        [ "${pid}" = "$$" ] && continue
        kill -9 "${pid}" 2>/dev/null || true
    done

    # 收集所有残留进程 PID（runner / dsh），排除自身与父 shell，先收集后杀
    # 注意：不能用裸 pkill -f，会误杀命令行中带相同特征串的执行 shell；
    # 模式必须带路径限定，避免命中仅文件名相同的无关进程
    local cleanup_pids
    cleanup_pids=$(pgrep -f "bin/runner\.js" 2>/dev/null; pgrep -f "@deepseek-ai/dsh.*bin\.js web" 2>/dev/null; pgrep -f "bin/proxy\.js" 2>/dev/null)
    for pid in $(echo "${cleanup_pids}" | sort -un); do
        [ -z "${pid}" ] && continue
        [ "${pid}" = "$$" ] && continue
        kill -9 "${pid}" 2>/dev/null || true
    done

    # 兜底：清理后确认端口已释放，否则如实报告失败，不输出伪成功
    sleep 1
    if ss -tln 2>/dev/null | grep -qE "${PORT_PATTERN}"; then
        log_msg "ERROR: port 3080/3081 still bound after stop"
        rm -f "${PID_FILE}" 2>/dev/null || true
        return 1
    fi
    rm -f "${PID_FILE}" 2>/dev/null || true
    log_msg "Stopped successfully"
    return 0
}

status_process() {
    if [ -f "${PID_FILE}" ]; then
        local pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        if instance_alive "${pid}"; then
            return 0
        fi
        rm -f "${PID_FILE}"
    fi
    # PID 文件丢失时按命令行特征兜底判断
    if recover_running_instance; then
        return 0
    fi
    return 3
}

case "$1" in
start)
    if start_process; then
        echo "✓ 启动成功"
        exit 0
    else
        echo "✗ 启动失败"
        exit 1
    fi
    ;;
stop)
    if stop_process; then
        echo "✓ 已停止"
        exit 0
    else
        echo "✗ 停止失败：端口 3080/3081 仍被占用，请查看日志 ${LOG_FILE}"
        exit 1
    fi
    ;;
uninstall)
    stop_process
    echo "✓ 已清理"
    exit 0
    ;;
status)
    if status_process; then
        echo "✓ 服务运行中"
        exit 0
    else
        echo "✗ 服务未运行"
        exit 3
    fi
    ;;
restart)
    stop_process
    sleep 1
    if start_process; then
        echo "✓ 重启成功"
        exit 0
    else
        echo "✗ 重启失败"
        exit 1
    fi
    ;;
*)
    echo "Usage: $0 {start|stop|status|restart|uninstall}"
    exit 1
    ;;
esac
